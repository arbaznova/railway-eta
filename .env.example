# ==============================================================
# Railway ETA Prediction System - Environment Configuration
# ==============================================================

# Database Connection URL:
# -------------------------
# Option 1: Managed PostgreSQL (Supabase / Render / Neon)
# Recommended: Use Supabase Session Pooler (port 6543 or 5432) with IPv4 support
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
# Example:
# DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Option 2: Local SQLite (Default fallback if DATABASE_URL is not set or commented out)
DATABASE_URL=sqlite:///rail_eda.db

# Server port (used by Render / Cloud runtimes)
PORT=8000
